---
import Button from "../UI/Button.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  mobileTitleLine1?: string;
  mobileTitleLine2?: string;
}

const {
  title = "Ariane Mader",
  subtitle = "A human!",
  backgroundImage = "/uploads/hero-bg.jpg",
  ctaText,
  ctaLink,
  secondaryCtaText,
  secondaryCtaLink,
  mobileTitleLine1,
  mobileTitleLine2,
} = Astro.props;

const showPrimary = Boolean(ctaText && ctaLink);
const showSecondary = Boolean(secondaryCtaText && secondaryCtaLink);
const showAnyCta = showPrimary || showSecondary;

const hasMobileTitleSplit = Boolean(
  mobileTitleLine1 && mobileTitleLine2
);
---

<section
  class="hero-section relative min-h-[50vh] flex items-center bg-cover pt-30"
  style={`background-image: url(${backgroundImage});`}
>
  <div class="container">
    <div class="max-w-3xl text-white">

      <!-- Title -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 text-white">
        {hasMobileTitleSplit ? (
          <>
            <!-- Mobile + medium screens -->
            <span class="lg:hidden">
              {mobileTitleLine1}<br />
              {mobileTitleLine2}
            </span>

            <!-- Large screens -->
            <span class="hidden lg:inline">
              {title}
            </span>
          </>
        ) : (
          title
        )}
      </h1>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl lg:text-2xl mb-8">
        {subtitle}
      </p>

      <!-- Optional CTA buttons -->
      {showAnyCta && (
        <div class="flex flex-wrap gap-4">
          {showPrimary && (
            <Button
              href={ctaLink}
              variant="primary"
              size="lg"
            >
              {ctaText}
            </Button>
          )}

          {showSecondary && (
            <Button
              href={secondaryCtaLink}
              variant="outline"
              size="lg"
              class="bg-white/10 text-white border-white hover:bg-white hover:text-gray-900 backdrop-blur-sm"
            >
              {secondaryCtaText}
            </Button>
          )}
        </div>
      )}

    </div>
  </div>
</section>

<style>
  .hero-section {
    background-position: 72% center;
  }

  @media (min-width: 1024px) {
    .hero-section {
      background-position: right 20%;
    }
  }
</style>