---
export interface Props {
  title: string;
  description: string;
  image?: {
    url: string;
    alt: string;
  };
  type?: "website" | "article";
  canonicalUrl?: string;
  author?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  nofollow?: boolean;
  lang?: "en" | "de";
}

const {
  title,
  description,
  image = {
    url: "/uploads/home-header.png",
    alt: "Ariane Mader, ADHD & Procrastination Coach",
  },
  type = "website",
  canonicalUrl,
  author,
  publishedTime,
  modifiedTime,
  noindex = false,
  nofollow = false,
  lang = "en",
} = Astro.props;

const siteUrl = "https://www.arianemader.com";
const currentPath = Astro.url.pathname;

// Canonical URL
const canonicalURL =
  canonicalUrl || new URL(currentPath, siteUrl).toString();

const imageUrl = new URL(image.url, siteUrl).toString();

// Matching EN/DE paths for hreflang
const englishPath = currentPath.startsWith("/de")
  ? currentPath.replace(/^\/de/, "") || "/"
  : currentPath;

const germanPath = currentPath.startsWith("/de")
  ? currentPath
  : `/de${currentPath === "/" ? "" : currentPath}`;

const englishUrl = new URL(englishPath, siteUrl).toString();
const germanUrl = new URL(germanPath, siteUrl).toString();

// English version acts as x-default
const defaultUrl = englishUrl;

const siteInfo = {
  name: "Ariane Mader",
  tagline:
    lang === "de"
      ? "ADHS- und Prokrastinationscoaching in Almere, Amsterdam und online"
      : "ADHD & Procrastination Coaching in Amsterdam, Almere & Online",
  url: siteUrl,
  email: "info@arianemader.com",
};

const robotsContent = [
  noindex ? "noindex" : "index",
  nofollow ? "nofollow" : "follow",
  "max-image-preview:large",
  "max-snippet:-1",
  "max-video-preview:-1",
].join(", ");

const ogLocale = lang === "de" ? "de_DE" : "en_US";
const alternateOgLocale = lang === "de" ? "en_US" : "de_DE";

const schemaLanguage = lang === "de" ? "de" : "en";

const personJobTitle =
  lang === "de"
    ? "ADHS- & Prokrastinationscoach"
    : "ADHD & Procrastination Coach";

const serviceType =
  lang === "de"
    ? "ADHS- & Prokrastinationscoaching"
    : "ADHD and Procrastination Coaching";
---

<title>{title}</title>

<meta name="description" content={description} />
<meta name="author" content={author || siteInfo.name} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />

<link rel="canonical" href={canonicalURL} />

<!-- hreflang -->
<link rel="alternate" hreflang="en" href={englishUrl} />
<link rel="alternate" hreflang="de" href={germanUrl} />
<link rel="alternate" hreflang="x-default" href={defaultUrl} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={image.alt} />
<meta property="og:site_name" content={siteInfo.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={alternateOgLocale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={image.alt} />

<meta name="theme-color" content="#193472" />
<meta name="format-detection" content="telephone=no" />

{type === "article" && publishedTime && (
  <meta
    property="article:published_time"
    content={publishedTime.toISOString()}
  />
)}

{type === "article" && modifiedTime && (
  <meta
    property="article:modified_time"
    content={modifiedTime.toISOString()}
  />
)}

<!-- WebSite structured data -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteInfo.name,
    url: siteInfo.url,
    description: siteInfo.tagline,
    inLanguage: schemaLanguage,
  })}
/>

<!-- Person structured data -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: siteInfo.name,
    url: siteInfo.url,
    email: siteInfo.email,
    jobTitle: personJobTitle,
  })}
/>

<!-- Service structured data -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    name: title,
    description: description,
    serviceType: serviceType,
    provider: {
      "@type": "Person",
      name: siteInfo.name,
      url: siteInfo.url,
      email: siteInfo.email,
      jobTitle: personJobTitle,
    },
    areaServed: [
      {
        "@type": "City",
        name: "Amsterdam",
      },
      {
        "@type": "City",
        name: "Almere",
      },
      {
        "@type": "Country",
        name: "Netherlands",
      },
    ],
    availableLanguage: ["en", "de"],
    url: canonicalURL,
  })}
/>
