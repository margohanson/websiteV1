---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
---

<BaseLayout
  title="Contact | Ariane Mader"
  seoTitle="Contact | Book a Free Intro Call"
  description="Get in touch with Ariane Mader to ask questions or book a free 30-minute introduction call for coaching or counselling."
  canonicalUrl="https://www.arianemader.com/contact"
  lang="en"
  alternateEn="https://www.arianemader.com/contact"
  alternateDe="https://www.arianemader.com/de/contact"
  xDefault="https://www.arianemader.com/contact"
>
  <PageHeader 
    title="Contact Me" 
    backgroundImage="/uploads/about-header.jpg"
    overlayOpacity={0.3}
  />

  <!-- Contact Info -->
  <section class="py-8">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-12 items-center">

        <!-- Contact Text -->
        <div>

          <!-- Get in touch -->
          <div class="prose prose-lg max-w-none">
            <h2 class="text-3xl blueFont font-bold !mt-2 mb-3">
              Get in touch
            </h2>

            <p class="mb-4">
              If you are curious about coaching, have questions, or would like to schedule your first appointment, I'd be happy to hear from you.<br>
              You can reach me at:
            </p>
          </div>

          <!-- Email -->
          <div class="not-prose flex items-center gap-2 mt-2 text-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 greenDarkFont flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>

            <a
              href="mailto:info@arianemader.com"
              class="text-gray-800 hover:text-[#30B28E] transition-colors"
            >
              info<span aria-hidden="true">[at]</span><span class="sr-only">@</span>arianemader.com
            </a>
          </div>

          <!-- Location -->
          <div class="prose prose-lg max-w-none">
            <p class="mt-4 mb-5">
              I offer coaching online and in person in <b>Amsterdam</b> and <b>Almere</b>.
            </p>
          </div>

          <!-- Free intro call -->
          <div class="prose prose-lg max-w-none">
            <h2 class="text-3xl blueFont font-bold !mt-5 mb-3">
              Free 30-minute introduction call
            </h2>

            <p>
              In this video call, we talk about what you want to achieve with coaching, explore how the further process might look, and see whether we are a good match. This is a chance to ask anything you want.
            </p>
          </div>

          <!-- Personal sign-off -->
          <p
            class="mt-5 mb-0 greenDarkFont text-xl md:text-2xl"
            style="font-family: 'Bradley Hand', 'Segoe Print', cursive;"
          >
            I look forward to hearing from you!
          </p>

        </div>

        <!-- Contact Image -->
        <img 
          src="/uploads/contact1.jpg" 
          alt="Contact image"
          class="rounded-lg shadow-lg object-cover w-full max-w-sm max-h-[380px] mx-auto"
        />

      </div>
    </div>
  </section>

</BaseLayout>