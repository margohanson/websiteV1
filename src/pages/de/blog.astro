---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import Button from "../../components/UI/Button.astro";
---

<BaseLayout
  title="Preise | Ariane Mader"
  seoTitle="Preise | Coaching, Counselling & Workshops"
  description="Preise für Einzelcoaching, Counselling und Workshops mit Ariane Mader. Online sowie vor Ort in Amsterdam und Almere."
  canonicalUrl="https://www.arianemader.com/de/prices"
  lang="de"
  alternateEn="https://www.arianemader.com/prices"
  alternateDe="https://www.arianemader.com/de/prices"
  xDefault="https://www.arianemader.com/prices"
>
  <PageHeader 
    title="Blog" 
    backgroundImage="/uploads/prices-header2.jpg"
    overlayOpacity={0.2}
  />
  
  <!-- Prices -->
<section class="py-16 bg-white">
  <div class="w-full">
    <div class="px-6 md:px-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Individuals -->
        <div class="p-4">
          <div class="prose prose-lg max-w-none prose-p:my-2">
            <h3 class="blueFont text-center">Coming Soon</h3>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>