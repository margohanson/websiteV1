---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/Sections/PageHeader.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../../utils/dateUtils";

const allPosts = await getCollection("blog-de", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const posts = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() -
    new Date(a.data.pubDate).getTime()
);

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title="Blog | Ariane Mader"
  seoTitle="Blog | ADHS, Prokrastination, Gewohnheiten & persönliche Entwicklung"
  seoDescription="Praktische Artikel über ADHS, Prokrastination, Gewohnheiten, Überforderung, berufliche Orientierung und nachhaltige Veränderung."
  lang="de"
>
  <PageHeader
    title="Blog"
    subtitle="Gedanken, Tools & praktische Impulse"
    backgroundImage="/uploads/blog4.jpg"
    overlayOpacity={0.3}
  />

  <section class="py-12 bg-white">
    <div class="w-full">
      <div class="px-6 md:px-20 lg:px-40">
        
        <!--
        <div class="max-w-3xl mx-auto prose prose-lg text-center mb-10">
          <p>
            Artikel über Prokrastination, ADHS, Gewohnheiten,
            Überforderung, persönliche Entwicklung und die Psychologie
            hinter nachhaltiger Veränderung.
          </p>
        </div>
        -->

        <!-- Search -->
        <div class="max-w-xl mx-auto mb-6">
          <label for="blog-search" class="sr-only">
            Artikel durchsuchen
          </label>

          <input
            id="blog-search"
            type="search"
            placeholder="Artikel durchsuchen..."
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#30B28E] focus:border-[#30B28E]"
          />
        </div>

        <!-- Tags -->
        {
          tags.length > 0 && (
            <div class="flex flex-wrap justify-center gap-3 mb-12">
              <button
                type="button"
                class="tag-filter active-tag px-4 py-2 rounded-full border border-[#30B28E] greenDarkFont text-sm font-medium transition-colors"
                data-tag="all"
              >
                Alle
              </button>

              {tags.map((tag) => (
                <button
                  type="button"
                  class="tag-filter px-4 py-2 rounded-full border border-gray-300 text-gray-700 text-sm font-medium hover:border-[#30B28E] hover:text-[#30B28E] transition-colors"
                  data-tag={tag}
                >
                  {tag}
                </button>
              ))}
            </div>
          )
        }

        <!-- Posts -->
        <div
          id="posts-grid"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
        >
          {
            posts.map((post) => (
              <article
                class="blog-card flex flex-col border border-gray-200 rounded-xl overflow-hidden bg-white"
                data-tags={post.data.tags.join(",").toLowerCase()}
                data-title={post.data.title.toLowerCase()}
                data-description={post.data.description.toLowerCase()}
              >
                {post.data.image && (
                  <a href={`/de/blog/${post.slug}`}>
                    <img
                      src={post.data.image.url}
                      alt={post.data.image.alt}
                      class="w-full aspect-[16/9] object-cover"
                      loading="lazy"
                    />
                  </a>
                )}

                <div class="p-6 flex flex-col flex-1">
                  <p class="text-sm text-gray-500 mb-2">
                    {formatDate(post.data.pubDate)}
                  </p>

                  <h2 class="blueFont text-xl font-bold mb-3">
                    <a
                      href={`/de/blog/${post.slug}`}
                      class="hover:text-[#30B28E] transition-colors"
                    >
                      {post.data.title}
                    </a>
                  </h2>

                  <p class="text-gray-700 mb-4 flex-1">
                    {post.data.description}
                  </p>

                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-5">
                      {post.data.tags.map((tag) => (
                        <span class="text-xs greenDarkFont">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <a
                    href={`/de/blog/${post.slug}`}
                    class="font-medium underline text-[#193472] hover:!text-[#30B28E] transition-colors"
                  >
                    Weiterlesen
                  </a>
                </div>
              </article>
            ))
          }
        </div>

        <div id="no-results" class="hidden text-center py-12">
          <p class="text-gray-600">
            Keine passenden Artikel gefunden.
          </p>
        </div>

      </div>
    </div>
  </section>

  <script>
    const initBlogFilters = () => {
      const searchInput = document.getElementById("blog-search");
      const filterButtons = document.querySelectorAll(".tag-filter");
      const cards = document.querySelectorAll(".blog-card");
      const noResults = document.getElementById("no-results");

      if (!searchInput) return;

      let selectedTag = "all";

      const filterPosts = () => {
        const searchTerm = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach((card) => {
          const title = card.getAttribute("data-title") || "";
          const description =
            card.getAttribute("data-description") || "";
          const tags = card.getAttribute("data-tags") || "";

          const matchesSearch =
            title.includes(searchTerm) ||
            description.includes(searchTerm) ||
            tags.includes(searchTerm);

          const matchesTag =
            selectedTag === "all" ||
            tags
              .split(",")
              .map((tag) => tag.trim())
              .includes(selectedTag.toLowerCase());

          const visible = matchesSearch && matchesTag;

          card.classList.toggle("hidden", !visible);

          if (visible) {
            visibleCount++;
          }
        });

        if (noResults) {
          noResults.classList.toggle("hidden", visibleCount !== 0);
        }
      };

      searchInput.addEventListener("input", filterPosts);

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          selectedTag = button.getAttribute("data-tag") || "all";

          filterButtons.forEach((b) => {
            b.classList.remove(
              "active-tag",
              "border-[#30B28E]",
              "greenDarkFont"
            );

            b.classList.add(
              "border-gray-300",
              "text-gray-700"
            );
          });

          button.classList.remove(
            "border-gray-300",
            "text-gray-700"
          );

          button.classList.add(
            "active-tag",
            "border-[#30B28E]",
            "greenDarkFont"
          );

          filterPosts();
        });
      });
    };

    initBlogFilters();

    document.addEventListener(
      "astro:after-swap",
      initBlogFilters
    );
  </script>
</BaseLayout>