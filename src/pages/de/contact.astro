---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
---

<BaseLayout
  title="Kontakt | Ariane Mader"
  seoTitle="Kontakt | Kostenloses Erstgespräch buchen"
  description="Nimm Kontakt mit Ariane Mader auf, stelle Fragen oder buche ein kostenloses 30-minütiges Erstgespräch für Coaching oder Counselling."
  canonicalUrl="https://www.arianemader.com/de/contact"
  lang="de"
  alternateEn="https://www.arianemader.com/contact"
  alternateDe="https://www.arianemader.com/de/contact"
  xDefault="https://www.arianemader.com/contact"
>
  <PageHeader 
    title="Kontakt" 
    backgroundImage="/uploads/about-header.jpg"
    overlayOpacity={0.3}
  />

  <!-- Contact Info -->
  <section class="py-8">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-12 items-center">

        <!-- Contact Text -->
        <div>

          <!-- Get in touch -->
          <div class="prose prose-lg max-w-none">
            <h2 class="text-3xl blueFont font-bold !mt-2 mb-3">
              Melde dich gern
            </h2>

            <p class="mb-4">
              Wenn du Fragen hast, mehr über Coaching wissen oder einen ersten Termin vereinbaren möchtest, freue ich mich, von dir zu hören.<br>
              Du erreichst mich unter:
            </p>
          </div>

          <!-- Email -->
          <div class="not-prose flex items-center gap-2 mt-2 text-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 greenDarkFont flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>

            <a
              href="mailto:info@arianemader.com"
              class="text-gray-800 hover:text-[#30B28E] transition-colors"
            >
              info<span aria-hidden="true">[at]</span><span class="sr-only">@</span>arianemader.com
            </a>
          </div>

          <!-- Location -->
          <div class="prose prose-lg max-w-none">
            <p class="mt-4 mb-5">
              Ich biete Coaching online sowie vor Ort in <b>Amsterdam</b> und <b>Almere</b> an.
            </p>
          </div>

          <!-- Free intro call -->
          <div class="prose prose-lg max-w-none">
            <h2 class="text-3xl blueFont font-bold !mt-5 mb-3">
              Kostenloses 30‑minütiges Kennenlerngespräch
            </h2>

            <p>
              Im (Video-)Erstgespräch klären wir, was du dir vom Coaching erhoffst, wie ein möglicher Prozess aussehen könnte und ob wir gut zueinander passen. 
              Du kannst alles fragen, was dir hilft, ein gutes Gefühl für mich und die Zusammenarbeit zu bekommen.
            </p>
          </div>

          <!-- Personal sign-off -->
          <p
            class="mt-5 mb-0 greenDarkFont text-xl md:text-2xl"
            style="font-family: 'Bradley Hand', 'Segoe Print', cursive;"
          >
            Ich freue mich auf deine Nachricht!
          </p>

        </div>

        <!-- Contact Image -->
        <img 
          src="/uploads/contact1.jpg" 
          alt="Contact image"
          class="rounded-lg shadow-lg object-cover w-full max-w-sm max-h-[380px] mx-auto"
        />

      </div>
    </div>
  </section>

</BaseLayout>