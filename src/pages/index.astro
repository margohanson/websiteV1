  <!-- JAVASCRIPT -->
  <!-- ========================= -->

  <script>
    const initTestimonials = () => {
      const grid = document.getElementById("testimonial-grid");
      const expanded = document.getElementById("testimonial-expanded");
      const backButton = document.getElementById("testimonial-back");

      if (!grid || !expanded || !backButton) return;

      const openButtons = document.querySelectorAll(".testimonial-open");
      const fullTestimonials = document.querySelectorAll(".testimonial-full");

      const openTestimonial = (id) => {
        fullTestimonials.forEach((testimonial) => {
          testimonial.classList.add("hidden");
        });

        const selected = document.querySelector(
          `[data-full-testimonial="${id}"]`
        );

        if (!selected) return;

        grid.classList.add("hidden");
        expanded.classList.remove("hidden");
        selected.classList.remove("hidden");

        document
          .getElementById("testimonials")
          ?.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
      };

      const closeTestimonial = () => {
        expanded.classList.add("hidden");

        fullTestimonials.forEach((testimonial) => {
          testimonial.classList.add("hidden");
        });

        grid.classList.remove("hidden");

        document
          .getElementById("testimonials")
          ?.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
      };

      openButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-testimonial");

          if (id) {
            openTestimonial(id);
          }
        });
      });

      backButton.addEventListener("click", closeTestimonial);
    };

    initTestimonials();

    document.addEventListener("astro:after-swap", initTestimonials);
  </script>


